# 复制到服务器私有文件后填写；不要提交真实密码。密码 URL 编码见部署说明。
# Windows 推荐使用 Setup/FirstRun.cmd；Setup 会加载 .env 并注入子进程，原应用入口不会自动加载。
DATABASE_URL=mysql+pymysql://course_app:URL_ENCODED_PASSWORD@127.0.0.1:3306/course_inventory?charset=utf8mb4
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
BCRYPT_ROUNDS=12
# 默认 code/runtime_logs；服务账号必须可写。多进程分别轮转，每进程最多约60MiB。
ACCESS_LOG_DIR=runtime_logs
